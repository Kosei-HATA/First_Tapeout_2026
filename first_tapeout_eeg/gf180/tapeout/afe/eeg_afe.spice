.subckt eeg_afe_nand2 Y A B VDD VSS s=1
XPA Y A VDD VDD pfet_03v3 W={2.5u*s} L=0.28u nf={s} m=1
XPB Y B VDD VDD pfet_03v3 W={2.5u*s} L=0.28u nf={s} m=1
XNA Y A M1 VSS nfet_03v3 W={2u*s} L=0.28u nf={s} m=1
XNB M1 B VSS VSS nfet_03v3 W={2u*s} L=0.28u nf={s} m=1
.ends eeg_afe_nand2
.subckt eeg_afe_nand3 Y A B C VDD VSS s=1
XPA Y A VDD VDD pfet_03v3 W={2.5u*s} L=0.28u nf={s} m=1
XPB Y B VDD VDD pfet_03v3 W={2.5u*s} L=0.28u nf={s} m=1
XPC Y C VDD VDD pfet_03v3 W={2.5u*s} L=0.28u nf={s} m=1
XNA Y A M1 VSS nfet_03v3 W={3u*s} L=0.28u nf={s} m=1
XNB M1 B M2 VSS nfet_03v3 W={3u*s} L=0.28u nf={s} m=1
XNC M2 C VSS VSS nfet_03v3 W={3u*s} L=0.28u nf={s} m=1
.ends eeg_afe_nand3
.subckt eeg_afe_tg A Y G GN VDD VSS
XN A G Y VSS nfet_03v3 W=1u L=0.28u nf=1 m=1
XP A GN Y VDD pfet_03v3 W=2u L=0.28u nf=1 m=1
.ends eeg_afe_tg

* Cpf trim: 27.3/54.5/109/218 fF per side (MIM; bit 0 is two smallest MIM caps in series),
* switched at the amplifier-output plate
.subckt eeg_afe_cpftrim WP WN OPI ONI VCM B0 B1 B2 B3 VDD VSS
XIB0 BN0 B0 VDD VSS eeg_afe_inv s=1
XCTP0A WP MP0 cap_mim_2f0ff c_length=5u c_width=5u
XCTP0B MP0 XP0 cap_mim_2f0ff c_length=5u c_width=5u
XTPO0 XP0 OPI B0 BN0 VDD VSS eeg_afe_tg
XTPV0 XP0 VCM BN0 B0 VDD VSS eeg_afe_tg
XCTN0A WN MN0 cap_mim_2f0ff c_length=5u c_width=5u
XCTN0B MN0 XN0 cap_mim_2f0ff c_length=5u c_width=5u
XTNO0 XN0 ONI B0 BN0 VDD VSS eeg_afe_tg
XTNV0 XN0 VCM BN0 B0 VDD VSS eeg_afe_tg
XIB1 BN1 B1 VDD VSS eeg_afe_inv s=1
XCTP1 WP XP1 cap_mim_2f0ff c_length=5u c_width=5u
XTPO1 XP1 OPI B1 BN1 VDD VSS eeg_afe_tg
XTPV1 XP1 VCM BN1 B1 VDD VSS eeg_afe_tg
XCTN1 WN XN1 cap_mim_2f0ff c_length=5u c_width=5u
XTNO1 XN1 ONI B1 BN1 VDD VSS eeg_afe_tg
XTNV1 XN1 VCM BN1 B1 VDD VSS eeg_afe_tg
XIB2 BN2 B2 VDD VSS eeg_afe_inv s=1
XCTP2 WP XP2 cap_mim_2f0ff c_length=7.17u c_width=7.17u
XTPO2 XP2 OPI B2 BN2 VDD VSS eeg_afe_tg
XTPV2 XP2 VCM BN2 B2 VDD VSS eeg_afe_tg
XCTN2 WN XN2 cap_mim_2f0ff c_length=7.17u c_width=7.17u
XTNO2 XN2 ONI B2 BN2 VDD VSS eeg_afe_tg
XTNV2 XN2 VCM BN2 B2 VDD VSS eeg_afe_tg
XIB3 BN3 B3 VDD VSS eeg_afe_inv s=1
XCTP3 WP XP3 cap_mim_2f0ff c_length=10.23u c_width=10.23u
XTPO3 XP3 OPI B3 BN3 VDD VSS eeg_afe_tg
XTPV3 XP3 VCM BN3 B3 VDD VSS eeg_afe_tg
XCTN3 WN XN3 cap_mim_2f0ff c_length=10.23u c_width=10.23u
XTNO3 XN3 ONI B3 BN3 VDD VSS eeg_afe_tg
XTNV3 XN3 VCM BN3 B3 VDD VSS eeg_afe_tg
.ends eeg_afe_cpftrim

* Cin, one side: 32 cap_mim_2f0ff of 99.7 um square in parallel (636 pF),
* the array of gf180/tapeout/layout/mim_arrays_lay.py. TOP: amplifier input, BOT: chopper side.
.subckt eeg_cin TOP BOT
XC0 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC1 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC2 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC3 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC4 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC5 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC6 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC7 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC8 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC9 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC10 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC11 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC12 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC13 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC14 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC15 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC16 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC17 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC18 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC19 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC20 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC21 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC22 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC23 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC24 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC25 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC26 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC27 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC28 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC29 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC30 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
XC31 TOP BOT cap_mim_2f0ff c_length=99.7u c_width=99.7u
.ends eeg_cin

* AFE top: input chopper TGs, Cin, Cf, Cpf, reset switches, DC path, offset DAC,
* amplifier, output chopper TGs
.subckt eeg_afe ELP ELN OUTP OUTN VCM VBN VBCM BLP BLN RST CIA NCIA CIB NCIB CDA NCDA CDB NCDB
+ OFPH OFS OFM0 OFM1 OFM2 OFM3 OFM4 OFM5 OFM6 OFM7 OFM8 OFM9 OFEN0 OFEN1 OFEN2 OFEN3 CPF0 CPF1 CPF2 CPF3 VDD VSS
XCINP INP WP eeg_cin
XCINN INN WN eeg_cin
XCFBP INP ONI cap_mim_2f0ff c_length=31.46u c_width=31.46u
XCFBN INN OPI cap_mim_2f0ff c_length=31.46u c_width=31.46u
XCPFP WP OPI cap_mim_2f0ff c_length=30.92u c_width=30.92u
XCPFN WN ONI cap_mim_2f0ff c_length=30.92u c_width=30.92u
XCPF WP WN OPI ONI VCM CPF0 CPF1 CPF2 CPF3 VDD VSS eeg_afe_cpftrim
XRSTP INP RST ONI VSS nfet_03v3 W=1u L=1u nf=1 m=1 ad=.5p as=.5p pd=3u ps=3u nrd=.5 nrs=.5
XRSTN INN RST OPI VSS nfet_03v3 W=1u L=1u nf=1 m=1 ad=.5p as=.5p pd=3u ps=3u nrd=.5 nrs=.5
* INP/INN DC path: switched-capacitor resistor to the opposite output (parallel to Cf),
* 54.52 fF per side (the smallest MIM cap), one transfer per chopper period
* (about 143 Mohm at 128 kHz)
XSCP1 INP CIA SCP VSS nfet_03v3 W=0.5u L=0.28u nf=1 m=1
XSCP2 SCP CIB ONI VSS nfet_03v3 W=0.5u L=0.28u nf=1 m=1
XCSCP SCP VSS cap_mim_2f0ff c_length=5u c_width=5u
XSCN1 INN CIA SCN VSS nfet_03v3 W=0.5u L=0.28u nf=1 m=1
XSCN2 SCN CIB OPI VSS nfet_03v3 W=0.5u L=0.28u nf=1 m=1
XCSCN SCN VSS cap_mim_2f0ff c_length=5u c_width=5u
XOFF INP INN VCM OFPH OFS OFM0 OFM1 OFM2 OFM3 OFM4 OFM5 OFM6 OFM7 OFM8 OFM9 OFEN0 OFEN1 OFEN2 OFEN3 VDD VSS eeg_afe_offdac
XAMP ELP ELN WP WN INP INN OPI ONI OUTP OUTN VCM VBN VBCM BLP BLN VBP CIA NCIA CIB NCIB CDA NCDA CDB NCDB VDD VSS eeg_afe_amp
* hold capacitors for output-chopper blanking (CDA/CDB low for 7 MCLK after each edge)
XCHOLDP_0 OUTP VSS cap_mim_2f0ff c_length=86.58u c_width=86.58u
XCHOLDP_1 OUTP VSS cap_mim_2f0ff c_length=86.58u c_width=86.58u
XCHOLDN_0 OUTN VSS cap_mim_2f0ff c_length=86.58u c_width=86.58u
XCHOLDN_1 OUTN VSS cap_mim_2f0ff c_length=86.58u c_width=86.58u
.ends eeg_afe
