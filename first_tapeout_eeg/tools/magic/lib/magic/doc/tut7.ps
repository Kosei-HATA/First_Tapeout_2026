8 -28 beginpath
3 -18 3 -15 0 0 curveto
-3 -15 -3 -18 -8 -28 curveto
-2 -26 2 -26 8 -28 curveto
249  1.00 endpath
endgate
} def

/arrowhead90 {
% -20 -12 36 24 bbox
begingate
1.00 90 -16 0 arrowhead
endgate
} def

